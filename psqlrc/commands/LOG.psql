-- Протокол работы сервера.
\if :{?hint}
\else
    \echo 'Файл "~postgres/.psqlrc" не загружен или не хватило прав доступа. Пройдите все шаги инсталляции с начала!'
    \quit
\endif

\include :script_dir/connect_psqlrc_db.psql
\if :{?QUIT}
    \unset QUIT
    \quit
\endif

\set title :log_title
\include :script_dir/title.psql

\if :is_csvlog
    \set table 'pro.csvlog':log_num
\else
    \set table 'pro.log':log_num
\endif

\set sql 'select row_number() over () as " #", * from ':table';'
:sql
\echo :sql

\unset title
\include :script_dir/title.psql

\include :script_dir/connect_restore.psql
