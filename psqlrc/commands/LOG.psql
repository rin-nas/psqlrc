-- Протокол работы сервера, последние 1000 строк из файла.
\if :{?hint}
\else
    \echo 'Файл "~postgres/.psqlrc" не загружен или не хватило прав доступа. Пройдите все шаги инсталляции с начала!'
    \quit
\endif

\include :script_dir/connect_psqlrc_db.psql
\if :{?QUIT}
    \unset QUIT
    \quit
\endif

\set title 'Postgres server log, last 1000 lines'
\include :script_dir/title.psql

\if :is_csvlog
    select row_number() over () as " #", * from pro.csvlog0;
\else
    select row_number() over () as " #", * from pro.log0;
\endif

\unset title
\include :script_dir/title.psql

\include :script_dir/connect_restore.psql
