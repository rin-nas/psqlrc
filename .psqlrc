/*
Последняя версия этого файла: https://github.com/rin-nas/psqlrc
Документация psql:            https://postgrespro.ru/docs/postgresql/current/app-psql
*/

-- цвета для \echo
\set red       '\033[38;5;160m'
\set green     '\033[38;5;2m'
\set blue      '\033[38;5;39m'
\set yellow    '\033[38;5;220m'
\set orange    '\033[38;5;214m'
\set magenta   '\033[38;5;129m'
\set cyan      '\033[38;5;6m'
\set gray      '\033[38;5;242m'
\set white     '\033[38;5;255m'
\set bold      '\033[1m'
\set italic    '\033[3m'
\set underline '\033[4m'
\set blink     '\033[5m'
\set reset     '\033[0m'

-- запоминаем флаг отображения информационных сообщений
\set QUIET_ORIGINAL :QUIET

-- отключаем отображение информационных сообщений для команд \pset и \timing
-- установка значения on эквивалента параметру командной строки `psql -q`
\set QUIET on

-- прекращаем обработку команд после возникновения ошибки, в интерактивном режиме psql вернётся в командную строку
\set ON_ERROR_STOP on

-- игнорируем ошибки только в интерактивных сеансах, но не в скриптах
\set ON_ERROR_ROLLBACK interactive

-- для каждой базы данных ведём отдельный файл истории выполненных команд
\set HISTFILE ~/.psql_history.:DBNAME

-- устанавливаем максимальное число команд, которые будут сохраняться в истории команд (по умолчанию 500)
\set HISTSIZE 9000

-- не добавляем в историю строки, которые в ней уже есть
\set HISTCONTROL ignoredups

-- редактор для команды \e
\setenv PSQL_EDITOR 'nano'

-- пейджер (если результат запроса не помещается на экране, он пропускается через эту программу)
\setenv PSQL_PAGER 'less -iMFXSx4R'
\if `command -v pspg &> /dev/null && echo 1 || echo 0`
    \pset expanded off
    \setenv PSQL_PAGER 'pspg --reprint-on-exit --blackwhite'
    \setenv PSQL_WATCH_PAGER 'pspg --reprint-on-exit --blackwhite --stream'
\endif

-- отображаем в таблицах рамки с непрерывными линиями
\pset linestyle unicode

-- отображаем значения NULL
\pset null '¤'

------------------------------------------------------------------------------------------------------------------------
-- получаем значения параметров СУБД для PROMPT1 и короткие SQL запросы

select
    trim((regexp_match(coalesce(
      -- example: Postgres Pro (shardman) 18.3.2 on x86_64-pc-linux-gnu, compiled by gcc (GCC) 13.3.1 20250418 (RED SOFT 13.3.1-3), 64-bit
      (select nullif(trim(setting), '') from pg_settings where name = 'pgpro_version' limit 1),

      -- example: PostgreSQL 18.3 on x86_64-pc-linux-gnu, compiled by gcc (GCC) 13.3.1 20250418 (RED SOFT 13.3.1-3), 64-bit
      -- example: PostgreSQL 16.11 (Ubuntu 16.11-1.pgdg24.04+1) on x86_64-pc-linux-gnu, compiled by gcc (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0, 64-bit
      -- example: PostgreSQL 19beta2 (Debian 19~beta2-1...) on x86_64-pc-linux-gnu...
      version()
    ), '^.+? \d+(?:\.\d+)*[^ ]* '))[1]) as pg_version,

    coalesce(
      (select ' ' || nullif(trim(setting), '') from pg_settings where name = 'pgpro_build' limit 1), -- example: c3d046b75bf
      ''
    ) as pg_build,

    -- именованные SQL запросы для быстрого доступа:
    'SELECT current_user, session_user, current_schemas(true) \gx' as "W",

    $sql$
        select
            backend_type,
            datname,
            state,
            usename,
            wait_event_type,
            wait_event,
            count(*) as "count_total",
            concat_ws('  ',
                count(*) filter (where state_change < now() - interval '1 second'),
                count(*) filter (where state_change < now() - interval '5 second'),
                count(*) filter (where state_change < now() - interval '1 minute'),
                count(*) filter (where state_change < now() - interval '1 hour')
            ) as "count_state_changed
> 1s/5s/1m/1h ago"
        from pg_stat_activity
        group by backend_type, datname, state, usename, wait_event_type, wait_event
        order by backend_type, datname, state, usename, wait_event_type, wait_event;
    $sql$ as "A"

\gset

------------------------------------------------------------------------------------------------------------------------
-- настраиваем приглашения командной строки PROMPT1 и PROMPT2

\set PROMPT2 '%R%x%# '

-- YYYY-MM-DD HH:MM:SS+HH:MM  user@host[IP]:/current_path/
\set PROMPT_OS '%`date --rfc-3339=seconds`  %`whoami`@%`hostname`[%`hostname -I | xargs`] %`pwd`'

-- pg_version pg_build  user@host:port/database
\set PROMPT_PG :pg_version'':pg_build'  %n@%M:%>/%/'
-- в Ubuntu 26.04 LTS в терминале v3.58.0 для GNOME 49 цветная строка отображается, но слишком длинная обрезается, поэтому закомментировано
-- \set PROMPT_PG :pg_version'':gray'':pg_build' ':yellow'%n':cyan'@':orange'%M':cyan':':green'%>':blue'/%/':reset

\set PROMPT1 '\n':PROMPT_OS'\n':PROMPT_PG'\n':PROMPT2

------------------------------------------------------------------------------------------------------------------------

\if :QUIET_ORIGINAL
  -- psql запущен с флагом -q
\else

    -- получаем значения параметров СУБД для вывода информационных сообщений
    with s as (
        select *, round((used_connections * 100.0) / max_connections) as used_connections_percent
        from (select (nullif(trim(setting), ''))::int from pg_settings where name = 'max_connections' limit 1) as s1(max_connections),
             (select count(*) as used_connections from pg_stat_activity) as t1(used_connections)
    )
    select
        s.*,
        pg_backend_pid(),
        pg_is_in_recovery(),
        coalesce((SELECT usesuper FROM pg_user WHERE usename = CURRENT_USER), false) as is_superuser,
        coalesce((SELECT client_addr IS NULL /*socket*/ OR client_addr IN ('::1', '127.0.0.1') FROM pg_stat_activity WHERE pid = pg_backend_pid()), false) as is_local_connection,
        exists(select from pg_extension where extname = 'pg_buffercache') as pg_buffercache_installed,

        (select nullif(trim(setting), '') from pg_settings where name = 'data_directory' limit 1) as data_directory,
        (select nullif(trim(setting), '') from pg_settings where name = 'log_directory' limit 1) as log_directory,
        (select pg_size_pretty(nullif(trim(setting), '')::numeric * 8192) from pg_settings where name = 'shared_buffers' limit 1) as shared_buffers,
        (select regexp_replace(nullif(trim(setting), ''), ',\s*', ', ', 'g') from pg_settings where name = 'shared_preload_libraries'   limit 1) as shared_preload_libraries,
        (select regexp_replace(nullif(trim(setting), ''), ',\s*', ', ', 'g') from pg_settings where name = 'walsender_plugin_libraries' limit 1) as walsender_plugin_libraries,
        (select nullif(trim(setting), '') from pg_settings where name = 'synchronous_commit' limit 1) as synchronous_commit, -- off / local / remote_write / on / remote_apply
        (select string_agg(concat(extname, ' ', extversion), ', ' order by extname) from pg_extension)  as installed_extensions,

        -- архивация WAL файлов
        exists(select from pg_settings where name = 'archive_mode' and setting != 'off') as is_archive_active,
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_mode'    limit 1) as archive_mode, -- off/on/always
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_timeout' limit 1) as archive_timeout,
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_command' limit 1) as archive_command,
        (select nullif(trim(setting), '') from pg_settings where name = 'restore_command' limit 1) as restore_command,

        pg_postmaster_start_time()::timestamptz(0) as started_at,
        pg_conf_load_time()::timestamptz(0)        as loaded_at,
        now()::timestamptz(0) - pg_postmaster_start_time()::timestamptz(0) as start_uptime,
        now()::timestamptz(0) - pg_conf_load_time()::timestamptz(0)        as load_uptime,

        coalesce((SELECT string_agg(concat(coalesce(s.slot_name, r.application_name, '¤'),
                                           '  ', r.usename,
                                                 '@',
                                                 coalesce(r.client_hostname,
                                                          host(r.client_addr),
                                                          (select nullif(trim(setting), '') from pg_settings where name = 'unix_socket_directories' limit 1),
                                                          '[socket]'),
                                                 ':',
                                                 r.client_port,
                                                 concat_ws('/', '', s.database),
                                           '  ', coalesce(s.slot_type, '¤'), -- physical/logical
                                           ' ', case when s.temporary is null then 'unknown' when s.temporary then 'temporary' else 'persistent' end,
                                           '  ', r.sync_state, -- async/potential/sync/quorum
                                           ' ', r.state,       -- startup/catchup/streaming/backup/stopping
                                           '  (lag: ', coalesce(a.total_lag_time_pretty, '¤'),
                                                 ', ', coalesce(b.total_lag_size_pretty, '¤'), ')'
                                          ),
                                    e'\n                  ' order by r.backend_start)
                  FROM pg_stat_replication AS r
                  LEFT JOIN pg_replication_slots AS s ON r.pid = s.active_pid
                  CROSS JOIN COALESCE(case when pg_is_in_recovery() then pg_last_wal_receive_lsn() else pg_current_wal_flush_lsn() end) AS t(last_lsn)
                  CROSS JOIN COALESCE(-- https://github.com/rin-nas/postgresql-patterns-library/blob/master/functions/interval_pretty.sql
                                      case when r.replay_lag =   '0'::interval then '0ms'
                                           when r.replay_lag <  '1s'::interval then regexp_replace(to_char(r.replay_lag, 'FMMS"ms"'), '^0+(?=\d+ms$)', '')
                                           when r.replay_lag < '10s'::interval then regexp_replace(to_char(r.replay_lag, 'FMSS"s" FMMS"ms"'), '(?<!\d)0+(?=\d+ms$)', '')
                                           when r.replay_lag <  '1m'::interval then to_char(r.replay_lag, 'FMSS"s"')
                                           when r.replay_lag <  '1h'::interval then to_char(r.replay_lag, 'FMMI"m" FMSS"s"')
                                           when r.replay_lag <  '1d'::interval then to_char(r.replay_lag, 'FMHH24"h" FMMI"m" FMSS"s"')
                                           else to_char(r.replay_lag, 'FMDD"d" FMHH24"h" FMMI"m" FMSS"s"')
                                      end) AS a (total_lag_time_pretty)
                  CROSS JOIN pg_size_pretty(t.last_lsn - r.replay_lsn) AS b (total_lag_size_pretty)
                 ), '') as wal_send_to,
        (SELECT COUNT(*) FROM pg_stat_replication) as wal_send_count,

        coalesce((SELECT concat(coalesce(slot_name, application_name, '¤'),
                               '  ', sender_user, '@', sender_host, ':', sender_port,
                               '  ', status, -- starting/stopped/stopping/streaming
                               '  ', case when pg_is_in_recovery() then pg_get_wal_replay_pause_state() end, -- not paused / pause requested / paused
                               '  (lag: ', coalesce(total_lag_time_pretty, '¤'),
                                     ', ', coalesce(total_lag_size_pretty, '¤'), ')'
                               )
                  FROM pg_stat_wal_receiver,
                       coalesce((regexp_match(conninfo, '\muser=([^ ]+)'))[1]) AS s (sender_user),
                       coalesce((regexp_match(conninfo, '\mfallback_application_name=([^ ]+)'))[1]) AS f (application_name),
                       coalesce(case when status != 'streaming' then null
                                     when latest_end_lsn = pg_last_wal_replay_lsn() then '0'::interval
                                     else now() - latest_end_time
                                end) AS a (total_lag_time),
                       coalesce(case when status != 'streaming' then null
                                     else latest_end_lsn - pg_last_wal_replay_lsn()
                                end) AS b (total_lag_size),
                       coalesce(-- https://github.com/rin-nas/postgresql-patterns-library/blob/master/functions/interval_pretty.sql
                                case when total_lag_time =   '0'::interval then '0ms'
                                     when total_lag_time <  '1s'::interval then regexp_replace(to_char(total_lag_time, 'FMMS"ms"'), '^0+(?=\d+ms$)', '')
                                     when total_lag_time < '10s'::interval then regexp_replace(to_char(total_lag_time, 'FMSS"s" FMMS"ms"'), '(?<!\d)0+(?=\d+ms$)', '')
                                     when total_lag_time <  '1m'::interval then to_char(total_lag_time, 'FMSS"s"')
                                     when total_lag_time <  '1h'::interval then to_char(total_lag_time, 'FMMI"m" FMSS"s"')
                                     when total_lag_time <  '1d'::interval then to_char(total_lag_time, 'FMHH24"h" FMMI"m" FMSS"s"')
                                     else to_char(total_lag_time, 'FMDD"d" FMHH24"h" FMMI"m" FMSS"s"')
                                end) AS c (total_lag_time_pretty),
                       pg_size_pretty(total_lag_size) AS d (total_lag_size_pretty)
                  LIMIT 1
                 ), '') as wal_receive_from,
        (SELECT COUNT(*) FROM pg_stat_wal_receiver) as wal_receive_count,

        -- database specific only
        db.datname as db_name,
        pg_size_pretty(pg_database_size(db.datname)) as db_size,
        db.blks_hit / nullif(db.blks_hit + db.blks_read, 0) as db_cache_hit_ratio

    from pg_stat_database as db, s
    where datname = current_database()
    \gset

    \if :pg_buffercache_installed
        SELECT
            pg_size_pretty(COUNT(*) * 8192) AS total_shared_buffers,
            pg_size_pretty(COUNT(*) FILTER (WHERE usagecount IS NOT NULL) * 8192) AS used_shared_buffers,
            ROUND(100.0 * COUNT(*) FILTER (WHERE usagecount IS NOT NULL) / COUNT(*)) AS used_shared_buffers_percent
        FROM pg_buffercache
        \gset
    \endif

    \if :is_local_connection
        \if :{?data_directory}
        \else
            -- если прав доступа не хватило, то пробуем получить data_directory альтернативным способом
            \set data_directory `ps -p $(ps -p :pg_backend_pid -o ppid=) -o cmd= | grep -o -P -- ' -D \K[^ ]+'`
        \endif

        -- определяем роль СУБД - мастер или реплика
        \if `test -r ':data_directory' && test -x ':data_directory' && echo 1 || echo 0`
            -- если прав доступа хватило
            \set is_primary `test -f ':data_directory/standby.signal' && echo 0 || echo 1`
        \endif

        \if :{?log_directory}
            \set log_directory `echo ':log_directory' | grep -q -P '^/' && echo ':log_directory' || echo ':data_directory/:log_directory'`
        \endif

        \set wal_directory :data_directory/pg_wal
        \set wal_real_directory `readlink -f :wal_directory`
        \set is_wal_directory_symlink `test :wal_directory != :wal_real_directory &> /dev/null && echo 1 || echo 0`

        \set data_directory_size `du -sh ':data_directory' | cut -d $'\t' -f1`
        \set wal_directory_size `du -sh ':wal_directory' | cut -d $'\t' -f1`
        \set log_directory_size `du -sh ':log_directory' | cut -d $'\t' -f1`
    \endif

    \if :{?is_primary}
    \else
        -- если прав доступа не хватило, получаем is_primary альтернативным способом
        -- но определять роль СУБД через SQL функцию pg_is_in_recovery() не всегда корректно
        \set is_primary `test :pg_is_in_recovery = f && echo 1 || echo 0`
    \endif

    --------------------------------------------------------------------------------------------------------------------
    -- выводим подсказки

    \if :is_superuser
    \else
        \echo :yellow'HINT: use to connect a user with the superuser attribute to show more information and validate configuration files':reset
    \endif

    \if :is_local_connection
    \else
        \echo :yellow'HINT: use local connection to show more details (directories size and etc.)':reset
    \endif

    \if :{?used_shared_buffers}
    \else
        \echo :yellow'HINT: run "create extension pg_buffercache" to show used/free cache size':reset
    \endif

    --------------------------------------------------------------------------------------------------------------------
    -- выводим информационные сообщения

    \echo :bold'# SERVER':reset
    \echo 'Started at:            ':started_at' (':start_uptime' ago)'
    \echo 'Config loaded at:      ':loaded_at' (':load_uptime' ago)'

    \if :{?data_directory}
        \set str 'Data directory:        ':data_directory
        \if :{?data_directory_size}
            \set str :str' (size: ':data_directory_size')'
        \endif
        \echo :str
    \endif

    \if :{?wal_directory}
        \set str 'WAL directory:         ':wal_directory
        \if :is_wal_directory_symlink
            \set str :str' -> ':wal_real_directory
        \endif
        \if :{?wal_directory_size}
            \set str :str' (size: ':wal_directory_size')'
        \endif
        \echo :str
    \endif

    \if :{?log_directory}
        \set str 'Log directory:         ':log_directory
        \if :{?log_directory_size}
            \set str :str' (size: ':log_directory_size')'
        \endif
        \echo :str
    \endif

    \if :{?max_connections}
        \echo 'Connections:           ':used_connections' of ':max_connections' (used ':used_connections_percent'%)'
    \endif

    \if :{?used_shared_buffers}
        \echo 'Shared buffers/cache:  ':used_shared_buffers' of ':total_shared_buffers' (used ':used_shared_buffers_percent'%)'
    \elif :{?shared_buffers}
        \echo 'Shared buffers/cache:  ':shared_buffers
    \endif

    \if :is_primary
        \echo 'Server role:           ':red'primary':reset
    \else
        \echo 'Server role:           ':magenta'replica':reset
        \echo 'WAL receive (':wal_receive_count'):       ':wal_receive_from
    \endif

    \echo 'WAL send (':wal_send_count'):          ':wal_send_to

    \echo 'Synchronous commit:    ':synchronous_commit

    \if :{?shared_preload_libraries}
        \echo 'Shared preload libs:   ':shared_preload_libraries
    \endif

    \if :{?walsender_plugin_libraries}
        \echo 'Walsender plugin libs: ':walsender_plugin_libraries
    \endif

    \if :is_archive_active
        \echo 'Archive mode:          ':archive_mode' (timeout: ':archive_timeout')'
        \if :{?archive_command}
            \echo 'Archive command:       ':archive_command
        \endif
        \if :{?restore_command}
            \echo 'Restore command:       ':restore_command
        \endif
    \else
        \echo 'Archive mode:          ':archive_mode
    \endif

    \echo :bold'\n# DATABASE':reset

    \echo 'Current database:      ':db_name' (size: ':db_size')'
    \echo 'Cache hit ratio:       ':db_cache_hit_ratio'%'

    \if :{?installed_extensions}
        \echo 'Installed extensions:  ':installed_extensions
    \endif

    \echo :bold'\n# SHORT SQL':reset
    \echo ':W - who am i'
    \echo ':A - stat activity groups counts'
    \echo

    \if :is_superuser

        -- проверяем наличие ошибок в конфигурационных файлах
        with fs as (
            select distinct on (name) *
            from pg_file_settings -- non commented rows of config files
            order by name, seqno desc
        )
        select
            current_setting('config_file') as config_file,
            current_setting('hba_file') as hba_file,
            exists(
                select
                from fs
                join pg_settings as s on lower(fs.name) = lower(s.name)
                where not fs.applied and not s.pending_restart
            ) as is_config_file_error,
            exists(select from pg_hba_file_rules where error is not null) as is_hba_file_error
        \gset

        \if :is_config_file_error
            \echo :red'Errors found in config file "':config_file'"':reset

            with fs as (
                select distinct on (name) *
                from pg_file_settings
                order by name, seqno desc
            )
            select fs.sourcefile, fs.sourceline, fs.name, fs.setting, fs.applied, fs.error,
                   s.vartype, s.min_val, s.max_val, s.enumvals, s.extra_desc
            from fs
            join pg_settings as s on lower(fs.name) = lower(s.name)
            where not fs.applied and not s.pending_restart
            order by fs.sourcefile, fs.sourceline
            \gx
        \endif

        \if :is_hba_file_error
            \echo :red'Errors found in hba file "':hba_file'"':reset

            select *
            from pg_hba_file_rules
            where error is not null
            order by line_number
            \gx
        \endif

    \endif

\endif

-- включаем отображение длительности выполнения запроса
\timing on

-- восстанавливаем флаг отображения информационных сообщений
\set QUIET :QUIET_ORIGINAL