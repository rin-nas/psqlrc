/*
Последняя версия этого файла: https://github.com/rin-nas/psqlrc
Документация psql:            https://postgrespro.ru/docs/postgresql/current/app-psql
*/

-- важно не сломать текущее поведение psql, на которое в скриптах уже заложились!
\if :{?pro}
    -- psql запущен с флагом -v pro=
\else
    \quit
\endif

-- цвета
\set red       '\033[38;5;1m'
\set green     '\033[38;5;10m'
\set blue      '\033[38;5;12m'
\set lightblue '\033[38;5;81m'
\set yellow    '\033[38;5;11m'
\set orange    '\033[38;5;9m'
\set cyan      '\033[38;5;6m'
\set magenta   '\033[38;5;13m'
\set gray      '\033[38;5;7m'
\set white     '\033[38;5;15m'

-- стили
\set bold      '\033[1m'
\set italic    '\033[3m'
\set underline '\033[4m'
\set blink     '\033[5m'
\set reset     '\033[0m'

-- типы сообщений
\set error :red
\set warn  :orange
\set hint  :yellow
\set succ  :green
\set head  :bold

-- стили для некоторых слов
\set primary_style          '\033[48;5;88m'
\set replica_active_style   '\033[48;5;130m'
\set replica_inactive_style '\033[48;5;8m'

-- запоминаем флаг отображения информационных сообщений
\set QUIET_ORIGINAL :QUIET

-- отключаем отображение информационных сообщений для команд \pset и \timing
-- установка значения 1 эквивалента параметру командной строки `psql -q`
\set QUIET 1

-- прекращаем обработку команд после возникновения ошибки, в интерактивном режиме psql вернётся в командную строку
\set ON_ERROR_STOP 1

-- игнорируем ошибки только в интерактивных сеансах, но не в скриптах
\set ON_ERROR_ROLLBACK interactive

-- для каждой базы данных ведём отдельный файл истории выполненных команд
\set HISTFILE ~/.psql_history.:DBNAME

-- устанавливаем максимальное число команд, которые будут сохраняться в истории команд (по умолчанию 500)
\set HISTSIZE 9000

-- не добавляем в историю строки, которые в ней уже есть
\set HISTCONTROL ignoredups

-- редактор для команды \e
\setenv PSQL_EDITOR 'nano'

-- пейджер (если результат запроса не помещается на экране, он пропускается через эту программу)
\set pspg_installed `command -v pspg > /dev/null 2>&1 && echo 1 || echo 0`
\set less_installed `command -v less > /dev/null 2>&1 && echo 1 || echo 0`
\if :pspg_installed
    \pset expanded off
    \setenv PSQL_PAGER       'pspg --freezecols=4 --reprint-on-exit --blackwhite --on-sigint-exit --no-sound'
    \setenv PSQL_WATCH_PAGER 'pspg --freezecols=4 --reprint-on-exit --blackwhite --on-sigint-exit --no-sound --stream'
\elif :less_installed
    \setenv PSQL_PAGER 'less -iMFXSx4R'
\endif

-- отображаем в таблицах рамки с непрерывными линиями
\pset linestyle unicode

-- отображаем значения NULL
\pset null '¤'
--\pset null '∅'

-- рамки вокруг таблицы
\pset border 2

------------------------------------------------------------------------------------------------------------------------
-- получаем значения параметров СУБД для PROMPT1 и короткие SQL запросы
select
    pg_is_in_recovery(),
    coalesce((SELECT usesuper FROM pg_user WHERE usename = CURRENT_USER), false) as is_superuser,

    trim((regexp_match(coalesce(
      -- example: Postgres Pro (shardman) 18.3.2 on x86_64-pc-linux-gnu, compiled by gcc (GCC) 13.3.1 20250418 (RED SOFT 13.3.1-3), 64-bit
      (select nullif(trim(setting), '') from pg_settings where name = 'pgpro_version' limit 1),

      -- example: PostgreSQL 18.3 on x86_64-pc-linux-gnu, compiled by gcc (GCC) 13.3.1 20250418 (RED SOFT 13.3.1-3), 64-bit
      -- example: PostgreSQL 16.11 (Ubuntu 16.11-1.pgdg24.04+1) on x86_64-pc-linux-gnu, compiled by gcc (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0, 64-bit
      -- example: PostgreSQL 19beta2 (Debian 19~beta2-1...) on x86_64-pc-linux-gnu...
      version()
    ), '^.+? \d+(?:\.\d+)*\S* '))[1]) as pg_version,

    coalesce(
      (select ' ' || nullif(trim(setting), '') from pg_settings where name = 'pgpro_build' limit 1), -- example: c3d046b75bf
      ''
    ) as pg_build
\gset

------------------------------------------------------------------------------------------------------------------------
\if `test :pro = install && echo 1 || echo 0`
    \echo 'Install...'

    \if :pg_is_in_recovery
        \echo :error'ERROR: connect to server role "primary" required':reset
        \quit
    \endif

    \if :is_superuser
    \else
        \echo :error'ERROR: connect a user (for example, postgres) with the superuser attribute required':reset
        \quit
    \endif

    START TRANSACTION;
        -- все объекты будем хранить в одной схеме "pro"
        drop schema if exists pro cascade;
        create schema pro;
        create extension if not exists dblink schema pro;

        -- https://github.com/rin-nas/postgresql-patterns-library/blob/master/functions/interval_pretty.sql
        create function pro.interval_pretty(interval)
            returns text
            immutable
            returns null on null input
            parallel safe
            language sql
            set search_path = ''
        return
            case when $1 =   '0'::interval then '0ms'
                 when $1 <  '1s'::interval then regexp_replace(to_char($1,                    'FMMS"ms"'),       '^0+(?=\d+ms$)', '')
                 when $1 < '10s'::interval then regexp_replace(to_char($1,            'FMSS"s" FMMS"ms"'), '(?<!\d)0+(?=\d+ms$)', '')
                 when $1 <  '1m'::interval then to_char($1,                           'FMSS"s"')
                 when $1 <  '1h'::interval then to_char($1,                   'FMMI"m" FMSS"s"')
                 when $1 <  '1d'::interval then to_char($1,         'FMHH24"h" FMMI"m" FMSS"s"')
                 else                           to_char($1, 'FMDD"d" FMHH24"h" FMMI"m" FMSS"s"')
            end;

        comment on function pro.interval_pretty(interval) is 'Formats the interval (time period) to a human readable string';

        CREATE VIEW pro.pg_cluster_topology AS
        -- Шаг 1. Движемся от листа к корню с целью получить мастер. В случае обрыва сетевого соединения остановимся на реплике.
        with recursive m as (
            select not pg_is_in_recovery()                                      as is_primary,
                   regexp_replace(nullif(trim(current_setting('primary_conninfo')), ''), '\m(application_name|connect_timeout)=\S*', '')
                       || ' application_name=dblink_topology connect_timeout=5' as conninfo,
                   coalesce(inet_server_addr(), '127.0.0.1'::inet)              as addr,
                   coalesce(inet_server_port(), current_setting('port')::int)   as port,
                   0                                                            as level
            union all
            select s.*,
                   m.level - 1
            from m, pro.dblink(
                        m.conninfo,
                        $$select
                            not pg_is_in_recovery(),
                            regexp_replace(nullif(trim(current_setting('primary_conninfo')), ''), '\m(application_name|connect_timeout)=\S*', '')
                                 || ' application_name=dblink_topology connect_timeout=5',
                            inet_server_addr(),
                            inet_server_port()
                        $$,
                        false --fail_on_error
                    ) as s (is_primary bool, conninfo text, addr inet, port int)
            where not m.is_primary and m.conninfo is not null
        )
        -- select * from m order by level; -- для отладки
        -- Шаг 2. Движемся от корня к листам с целью получить информацию о репликах
        , r as (
            (select 1                          as level,
                    m.is_primary               as is_primary,
                    null::inet                 as parent_addr,
                    m.addr                     as addr,
                    m.port                     as port,
                    null::pg_lsn               as last_lsn,
                    null::pg_stat_replication  as pg_sr,
                    null::pg_replication_slots as pg_rs
            from m
            order by m.level
            limit 1)
            union all
            select r.level + 1           as level,
                   false                 as is_primary,
                   r.addr                as parent_addr,
                   (s.pg_sr).client_addr as addr,
                   r.port,
                   s.last_lsn,
                   s.pg_sr,
                   s.pg_rs
            from r, pro.dblink(format('user=postgres host=%s port=%s dbname=postgres application_name=dblink_topology connect_timeout=5', r.addr, r.port),
                           $$select w.last_lsn, pg_sr, pg_rs
                             from pg_stat_replication as pg_sr
                             left join pg_replication_slots as pg_rs on pg_sr.pid = pg_rs.active_pid
                             cross join coalesce(case when pg_is_in_recovery() then pg_last_wal_receive_lsn() else pg_current_wal_lsn() end) as w(last_lsn)
                           $$,
                           false --fail_on_error
                          ) as s (last_lsn pg_lsn,
                                  pg_sr    pg_stat_replication,
                                  pg_rs    pg_replication_slots)
        )
        select level, is_primary, parent_addr, addr, port, last_lsn,
               s.*, clock_timestamp() as local_dblink_connection_end,
               (pg_sr).*, (pg_rs).*
        from r, pro.dblink(format('user=postgres host=%s port=%s dbname=postgres application_name=dblink_topology connect_timeout=5', r.addr, r.port),
                           format($sql$
                                  -- https://postgrespro.ru/docs/postgresql/current/runtime-config-replication
                                  with guc_replica as (
                                      select
                                          -- Ведомые серверы. Эти параметры управляют поведением ведомого сервера, который будет получать данные репликации. На ведущем сервере они не играют никакой роли.
                                          (select nullif(trim(setting), '')         from pg_settings where name = 'primary_conninfo'             limit 1) as primary_conninfo,
                                          (select nullif(trim(setting), '')         from pg_settings where name = 'primary_slot_name'            limit 1) as primary_slot_name,
                                          (select (nullif(trim(setting), ''))::bool from pg_settings where name = 'hot_standby'                  limit 1) as hot_standby,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'max_standby_archive_delay'    limit 1) as max_standby_archive_delay,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'max_standby_streaming_delay'  limit 1) as max_standby_streaming_delay,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'wal_receiver_status_interval' limit 1) as wal_receiver_status_interval,
                                          (select (nullif(trim(setting), ''))::bool from pg_settings where name = 'hot_standby_feedback'         limit 1) as hot_standby_feedback,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'wal_receiver_timeout'         limit 1) as wal_receiver_timeout,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'wal_retrieve_retry_interval'  limit 1) as wal_retrieve_retry_interval,
                                          (select (nullif(trim(setting), ''))::int  from pg_settings where name = 'recovery_min_apply_delay'     limit 1) as recovery_min_apply_delay,
                                          (select (nullif(trim(setting), ''))::bool from pg_settings where name = 'sync_replication_slots'       limit 1) as sync_replication_slots
                                  )
                                  select
                                      jsonb_pretty(to_jsonb(guc_replica))::json as guc_replica,
                                      case when pg_is_in_recovery() then pg_get_wal_replay_pause_state() end as pause_state, -- not paused / pause requested / paused
                                      (select nullif(trim(setting), '')  from pg_settings where name = 'biha.host' limit 1) as biha_host,
                                      %L                as local_dblink_connection_start,
                                      a.backend_start   as remote_dblink_connection_start,
                                      clock_timestamp() as remote_dblink_connection_end
                                  from pg_stat_activity as a, guc_replica
                                  where a.pid = pg_backend_pid()
                                  $sql$, clock_timestamp()),
                           false --fail_on_error
                          ) as s (guc_replica                    json,
                                  pause_state                    text,
                                  biha_host                      text,
                                  local_dblink_connection_start  timestamptz,
                                  remote_dblink_connection_start timestamptz,
                                  remote_dblink_connection_end   timestamptz);

        COMMENT ON VIEW pro.pg_cluster_topology IS 'Cluster topology. Returns servers: master and dependent replicas, including cascaded ones.';

        -- select * from pro.pg_cluster_topology; -- для отладки

    COMMIT;

    \if :ERROR
        \echo :error'Install fail':reset
    \else
        \echo :succ'Install success':reset
    \endif

\endif

------------------------------------------------------------------------------------------------------------------------
-- настраиваем приглашения командной строки PROMPT1 и PROMPT2

\set PROMPT2 '%R%x%# '

-- YYYY-MM-DD HH:MM:SS+HH:MM  user@host[IP]:/current_path/
\set PROMPT_OS '%`date --rfc-3339=seconds`  %`whoami`@%`hostname`[%`hostname -I | xargs`] %`pwd`'

-- pg_version pg_build  user@host:port/database
\set PROMPT_PG :pg_version'':pg_build'  %n@%M:%>/%/'

\if `test :pro = color && echo 1 || echo 0`
    -- в Ubuntu 26.04 LTS в терминале v3.58.0 для GNOME 49 цветная строка отображается, но слишком длинная обрезается!
    \set PROMPT_PG :pg_version'':gray'':pg_build' ':yellow'%n':cyan'@':orange'%M':cyan':':green'%>':blue'/%/':reset
\endif

\set PROMPT1 '\n':PROMPT_OS'\n':PROMPT_PG'\n':PROMPT2

------------------------------------------------------------------------------------------------------------------------
-- устанавливаем именованные SQL запросы для быстрого доступа
select
    -- https://postgrespro.ru/docs/postgresql/current/functions-info
    $sql$
        SELECT pg_backend_pid(),
               pg_current_xact_id_if_assigned(), -- идентификатор текущей транзакции или NULL, если она ещё не имеет идентификатора
               pg_xact_status(pg_current_xact_id_if_assigned()) as pg_current_xact_status, -- состояние фиксации транзакции: in progress / committed / aborted
               coalesce((SELECT usesuper FROM pg_user WHERE usename = CURRENT_USER), false) as is_superuser,
               CURRENT_USER,  -- = current_role
               SESSION_USER,
               current_database(),
               current_schema(),
               current_schemas(true),
               pg_current_logfile(),
               inet_client_addr(),
               inet_client_port(),
               inet_server_addr(),
               inet_server_port(),
               pg_jit_available(),
               pg_numa_available(),
               version(),
               unicode_version(),
               icu_unicode_version()
               \gx
    $sql$ as "W",

    $sql$
        select
            backend_type,
            datname,
            state,
            usename,
            wait_event_type,
            wait_event,
            count(*) as "count_total",
            concat_ws(' ',
                lpad((count(*) filter (where state_change < now() - interval '1 second'))::text, 3, ' '),
                lpad((count(*) filter (where state_change < now() - interval '5 second'))::text, 3, ' '),
                lpad((count(*) filter (where state_change < now() - interval '1 minute'))::text, 3, ' '),
                lpad((count(*) filter (where state_change < now() - interval '1 hour'))::text,   3, ' ')
            ) as U&"count_state_changed\000A> 1s/5s/1m/1h ago"
        from pg_stat_activity
        group by backend_type, datname, state, usename, wait_event_type, wait_event
        order by backend_type, datname, state, usename, wait_event_type, wait_event;
    $sql$ as "A",

    /*
    Значений полей для вывода много. Необходимо, чтобы таблица уместилось на широкоформатный экран разрешением 2880×1800 (16:10).
    Для этого применены следующие хитрости:
    1) Названия колонок и значения выводятся в две строки вместо одной
    2) Несколько логически взаимосвязанных значений объединены в одной колонке
    3) В дате-времени удалены миллисекунды
    4) Для размеров в байтах и интервалов времени выводится только значимая информация
    */
    $sql$
        select
            level,
            case when is_primary then 'primary' else 'replica' end as role,
            concat_ws(E'\n',
                parent_addr,
                nullif((regexp_match(guc_replica->>'primary_conninfo', '\mhost=(\S+)'))[1], parent_addr::text)
            ) as U&"parent_addr\000Aparent_host",
            concat_ws(E'\n',
                addr,
                coalesce(
                    client_hostname, -- это поле будет отлично от null только в случае соединений по IP и только при включённом режиме log_hostname
                    biha_host
                )
            ) as U&"addr\000Ahost",
            port,
            pro.interval_pretty(d2.local_dblink_connection_duration - d1.remote_dblink_connection_duration) as ping,
            --usename as user,
            concat_ws(E'\n', application_name, slot_name) as U&"app_name\000Aslot_name",
            concat_ws(E'\n',
                state,      -- startup / catchup / streaming / backup / stopping
                pause_state -- not paused / pause requested / paused
            ) as state,
            concat_ws(E'\n',
                sync_state, -- async/potential/sync/quorum
                sync_priority
            ) as U&"mode\000Apriority",
            /*
            --TODO
            case when not is_primary then
                concat(
                    replace(pg_size_pretty(last_lsn - restart_lsn), ' bytes', ''),
                    E'\n',
                    (guc_replica->>'hot_standby_feedback')::bool
                ) else '' end as U&"hold_size\000Afeedback",
            */
            concat(
                         replace(pg_size_pretty(last_lsn   - sent_lsn),   ' bytes', ''), -- data sending WAL stream to replica via network by walsender
                ' + ' || replace(pg_size_pretty(sent_lsn   - write_lsn),  ' bytes', ''), -- data receiving WAL stream on replica from network by walreciever
                ' + ' || replace(pg_size_pretty(write_lsn  - flush_lsn),  ' bytes', ''), -- data writing WAL on disk on replica by walreciever
                ' + ' || replace(pg_size_pretty(flush_lsn  - replay_lsn), ' bytes', ''), -- data applying (replaying) WAL as a recovery process
                ' = ' || replace(pg_size_pretty(last_lsn   - replay_lsn), ' bytes', '')
            ) as U&"lag_size\000Asend+write+flush+replay=total",
            concat_ws(' → ',
                pro.interval_pretty(write_lag), -- time elapsed between flushing recent WAL locally and receiving notification that this standby server has written it (but not yet flushed it or applied it)
                pro.interval_pretty(flush_lag), -- time elapsed between flushing recent WAL locally and receiving notification that this standby server has written and flushed it (but not yet applied it)
                pro.interval_pretty(replay_lag) -- time elapsed between flushing recent WAL locally and receiving notification that this standby server has written, flushed and applied it
            ) as U&"lag_time\000Awrite flush replay",
            coalesce(replace(backend_start::timestamptz(0)::text, ' ', E'\n'), E'\n') as start_at,
            coalesce(replace(reply_time::timestamptz(0)::text,    ' ', E'\n'), E'\n') as reply_at,
            concat(
                slot_type, -- physical/logical
                case when slot_type = 'logical' then concat(', db:', database, ', failover:', failover, ', synced:', synced) end,
                E'\n', active, ' ', temporary
            ) as U&"slot_type\000Aactive temp",
            concat_ws(E'\n',
                concat(wal_status, ', reason:' || invalidation_reason, ', since:' || inactive_since::timestamptz(0)::text),
                pg_size_pretty(safe_wal_size)
            ) as U&"wal_status\000Asafe_wal_size"
        from pro.pg_cluster_topology as t,
        coalesce(remote_dblink_connection_end - remote_dblink_connection_start) as d1(remote_dblink_connection_duration),
        coalesce(local_dblink_connection_end  - local_dblink_connection_start)  as d2(local_dblink_connection_duration)
        order by t.level, t.state, t.sync_state desc;
    $sql$ as "T"

\gset

------------------------------------------------------------------------------------------------------------------------
\if :QUIET_ORIGINAL
    -- psql запущен с флагом -q
\else

    \echo 'https://github.com/rin-nas/psqlrc'

    -- получаем значения параметров СУБД для вывода информационных сообщений
    with s as (
        select *, round((used_connections * 100.0) / max_connections) as used_connections_percent
        from (select (nullif(trim(setting), ''))::int from pg_settings where name = 'max_connections' limit 1) as s1(max_connections),
             (select count(*) as used_connections from pg_stat_activity) as t1(used_connections)
    )
    select
        s.*,
        pg_backend_pid(),
        coalesce((SELECT client_addr IS NULL /*socket*/ OR client_addr IN ('::1', '127.0.0.1') FROM pg_stat_activity WHERE pid = pg_backend_pid()), false) as is_local_connection,
        exists(select from pg_extension where extname = 'pg_buffercache') as pg_buffercache_installed,

        (select nullif(trim(setting), '') from pg_settings where name = 'data_directory' limit 1) as data_directory,
        (select nullif(trim(setting), '') from pg_settings where name = 'logging_collector' limit 1) as logging_collector,
        (select nullif(trim(setting), '') from pg_settings where name = 'log_directory' limit 1) as log_directory,
        (select pg_size_pretty(nullif(trim(setting), '')::numeric * 8192) from pg_settings where name = 'shared_buffers' limit 1) as shared_buffers,
        (select regexp_replace(nullif(trim(setting), ''), ',\s*', ', ', 'g') from pg_settings where name = 'shared_preload_libraries'   limit 1) as shared_preload_libraries,
        (select regexp_replace(nullif(trim(setting), ''), ',\s*', ', ', 'g') from pg_settings where name = 'walsender_plugin_libraries' limit 1) as walsender_plugin_libraries,
        (select nullif(trim(setting), '') from pg_settings where name = 'synchronous_standby_names' limit 1) as synchronous_standby_names,
        (select nullif(trim(setting), '') from pg_settings where name = 'synchronous_commit' limit 1) as synchronous_commit, -- off / local / remote_write / on / remote_apply
        (select string_agg(concat(extname, ' ', extversion), ', ' order by extname) from pg_extension)  as installed_extensions,

        -- архивация WAL файлов
        exists(select from pg_settings where name = 'archive_mode' and setting != 'off') as is_archive_active,
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_mode'    limit 1) as archive_mode, -- off/on/always
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_timeout' limit 1) as archive_timeout,
        (select nullif(trim(setting), '') from pg_settings where name = 'archive_command' limit 1) as archive_command,
        (select nullif(trim(setting), '') from pg_settings where name = 'restore_command' limit 1) as restore_command,

        pg_postmaster_start_time()::timestamptz(0) as started_at,
        pg_conf_load_time()::timestamptz(0)        as loaded_at,
        now()::timestamptz(0) - pg_postmaster_start_time()::timestamptz(0) as start_uptime,
        now()::timestamptz(0) - pg_conf_load_time()::timestamptz(0)        as load_uptime,

        coalesce((SELECT string_agg(concat(coalesce(s.slot_name, r.application_name, '¤'),
                                           '  ', r.usename,
                                                 '@',
                                                 coalesce(r.client_hostname,
                                                          host(r.client_addr),
                                                          (select nullif(trim(setting), '') from pg_settings where name = 'unix_socket_directories' limit 1),
                                                          '[socket]'),
                                                 ':',
                                                 r.client_port,
                                                 concat_ws('/', '', s.database),
                                           '  ', coalesce(s.slot_type, '¤'), -- physical/logical
                                           ' ', case when s.temporary is null then 'unknown' when s.temporary then 'temporary' else 'persistent' end,
                                           '  ', r.sync_state, -- async/potential/sync/quorum
                                           ' ', r.state,       -- startup/catchup/streaming/backup/stopping
                                           '  (lag: ', coalesce(a.total_lag_time_pretty, '¤'),
                                                 ', ', coalesce(b.total_lag_size_pretty, '¤'), ')'
                                          ),
                                    e'\n                       ' order by r.backend_start)
                  FROM pg_stat_replication AS r
                  LEFT JOIN pg_replication_slots AS s ON r.pid = s.active_pid
                  CROSS JOIN COALESCE(case when pg_is_in_recovery() then pg_last_wal_receive_lsn() else pg_current_wal_lsn() end) AS t(last_lsn)
                  CROSS JOIN COALESCE(-- https://github.com/rin-nas/postgresql-patterns-library/blob/master/functions/interval_pretty.sql
                                      case when r.replay_lag =   '0'::interval then '0ms'
                                           when r.replay_lag <  '1s'::interval then regexp_replace(to_char(r.replay_lag, 'FMMS"ms"'), '^0+(?=\d+ms$)', '')
                                           when r.replay_lag < '10s'::interval then regexp_replace(to_char(r.replay_lag, 'FMSS"s" FMMS"ms"'), '(?<!\d)0+(?=\d+ms$)', '')
                                           when r.replay_lag <  '1m'::interval then to_char(r.replay_lag, 'FMSS"s"')
                                           when r.replay_lag <  '1h'::interval then to_char(r.replay_lag, 'FMMI"m" FMSS"s"')
                                           when r.replay_lag <  '1d'::interval then to_char(r.replay_lag, 'FMHH24"h" FMMI"m" FMSS"s"')
                                           else to_char(r.replay_lag, 'FMDD"d" FMHH24"h" FMMI"m" FMSS"s"')
                                      end) AS a (total_lag_time_pretty)
                  CROSS JOIN pg_size_pretty(t.last_lsn - r.replay_lsn) AS b (total_lag_size_pretty)
                 ), '') as wal_send_to,
        (SELECT COUNT(*) FROM pg_stat_replication) as wal_send_count,

        coalesce((SELECT concat(coalesce(slot_name, application_name, '¤'),
                               '  ', sender_user, '@', sender_host, ':', sender_port,
                               '  ', status, -- starting/stopped/stopping/streaming
                               '  ', case when pg_is_in_recovery() then pg_get_wal_replay_pause_state() end, -- not paused / pause requested / paused
                               '  (lag: ', coalesce(total_lag_time_pretty, '¤'),
                                     ', ', coalesce(total_lag_size_pretty, '¤'), ')'
                               )
                  FROM pg_stat_wal_receiver,
                       coalesce((regexp_match(conninfo, '\muser=(\S+)'))[1]) AS s (sender_user),
                       coalesce((regexp_match(conninfo, '\mapplication_name=(\S+)'))[1]) AS f (application_name),
                       coalesce(case when status != 'streaming' then null
                                     when latest_end_lsn = pg_last_wal_replay_lsn() then '0'::interval
                                     else now() - latest_end_time
                                end) AS a (total_lag_time),
                       coalesce(case when status != 'streaming' then null
                                     else latest_end_lsn - pg_last_wal_replay_lsn()
                                end) AS b (total_lag_size),
                       coalesce(-- https://github.com/rin-nas/postgresql-patterns-library/blob/master/functions/interval_pretty.sql
                                case when total_lag_time =   '0'::interval then '0ms'
                                     when total_lag_time <  '1s'::interval then regexp_replace(to_char(total_lag_time, 'FMMS"ms"'), '^0+(?=\d+ms$)', '')
                                     when total_lag_time < '10s'::interval then regexp_replace(to_char(total_lag_time, 'FMSS"s" FMMS"ms"'), '(?<!\d)0+(?=\d+ms$)', '')
                                     when total_lag_time <  '1m'::interval then to_char(total_lag_time, 'FMSS"s"')
                                     when total_lag_time <  '1h'::interval then to_char(total_lag_time, 'FMMI"m" FMSS"s"')
                                     when total_lag_time <  '1d'::interval then to_char(total_lag_time, 'FMHH24"h" FMMI"m" FMSS"s"')
                                     else to_char(total_lag_time, 'FMDD"d" FMHH24"h" FMMI"m" FMSS"s"')
                                end) AS c (total_lag_time_pretty),
                       pg_size_pretty(total_lag_size) AS d (total_lag_size_pretty)
                  LIMIT 1
                 ), '') as wal_receive_from,
        (SELECT COUNT(*) FROM pg_stat_wal_receiver) as wal_receive_count,

        -- database specific only
        db.datname as db_name,
        pg_size_pretty(pg_database_size(db.datname)) as db_size,
        db.blks_hit / nullif(db.blks_hit + db.blks_read, 0) as db_cache_hit_ratio

    from pg_stat_database as db, s
    where datname = current_database()
    \gset

    \if :pg_buffercache_installed
        SELECT
            pg_size_pretty(COUNT(*) * 8192) AS total_shared_buffers,
            pg_size_pretty(COUNT(*) FILTER (WHERE usagecount IS NOT NULL) * 8192) AS used_shared_buffers,
            ROUND(100.0 * COUNT(*) FILTER (WHERE usagecount IS NOT NULL) / COUNT(*)) AS used_shared_buffers_percent
        FROM pg_buffercache
        \gset
    \endif

    \if :is_local_connection

        \set postgres_pid  `ps -p :pg_backend_pid -o ppid= | xargs`
        \set systemd_unit  `ps -p :pg_backend_pid -o unit= | xargs`
        \set bin_directory `dirname $(realpath /proc/:pg_backend_pid/exe)`

        \if :{?data_directory}
        \else
            -- если прав доступа не хватило, то пробуем получить data_directory альтернативным способом
            \set data_directory `ps -p :postgres_pid -o cmd= | grep -oP -- ' -D \K\S+'`
        \endif

        -- определяем роль СУБД - мастер или реплика
        \if `test -r ':data_directory' && test -x ':data_directory' && echo 1 || echo 0`
            -- если прав доступа хватило
            \set is_primary `test -f ':data_directory/standby.signal' && echo 0 || echo 1`
        \endif

    \endif

    \if :{?is_primary}
    \else
        -- если прав доступа не хватило, получаем is_primary альтернативным способом
        -- но определять роль СУБД через SQL функцию pg_is_in_recovery() не всегда корректно
        \set is_primary `test :pg_is_in_recovery = f && echo 1 || echo 0`
    \endif

    \set wal_directory :data_directory'/pg_wal'

    \if :{?logging_collector}
        \if :logging_collector
            \if :{?log_directory}
                \if `echo :log_directory | grep -qP '^/' && echo 1 || echo 0`
                \else
                    \set log_directory :data_directory'/':log_directory
                \endif
            \else
                \set log_directory :data_directory
            \endif
        \else
            \unset log_directory
        \endif
    \endif

    -- вычисляем ссылки и размеры директорий
    \if `test :pro = 1 && echo 1 || echo 0`
        \if :is_local_connection
            select now() as calc_dir_size_start \gset

            \set wal_real_directory `readlink -f ':wal_directory'`
            \if `test ':wal_directory' = ':wal_real_directory' && echo 1 || echo 0`
                \unset wal_real_directory
            \endif

            \set data_directory_size `du -sh ':data_directory' | grep -oP '^\S+'`

            \if :{?wal_real_directory}
                \set wal_directory_size `du -sh ':wal_real_directory' | grep -oP '^\S+'`
            \else
                \set wal_directory_size `du -sh ':wal_directory' | grep -oP '^\S+'`
            \endif

            \if :{?log_directory}
                \set log_files_size `find ':log_directory' -maxdepth 1 -type f -exec du -ch {} + | tail -1 | grep -oP '^\S+'`
            \endif

            select now() - :'calc_dir_size_start' > '1s'::interval as is_calc_dir_size_slow \gset
        \endif
    \endif

    --------------------------------------------------------------------------------------------------------------------
    -- выводим подсказки

    \if :pspg_installed
    \else
        \echo :hint'HINT: alternative pager "pspg" is supported and highly recommended to use, see https://github.com/okbob/pspg':reset
    \endif

    \if :is_superuser
    \else
        \echo :hint'HINT: use to connect a user with the superuser attribute to show more information and validate configuration files':reset
    \endif

    \if :is_local_connection
    \else
        \echo :hint'HINT: use local connection to show more details (directories size and etc.)':reset
    \endif

    \if :{?used_shared_buffers}
    \else
        \echo :hint'HINT: run "create extension pg_buffercache;" to show used/free cache size':reset
    \endif

    \if :{?logging_collector}
        \if :logging_collector
        \else
            \echo :warn'WARNING: logging collector is disabled, it is recommended to enable':reset
            \echo :hint'HINT: errors are redirected to syslog':reset
        \endif
    \endif

    \if :{?is_calc_dir_size_slow}
        \if :is_calc_dir_size_slow
            \echo :hint'HINT: calculating the directories size is slow, to disable the calculation, run `psql -v pro=0`':reset
        \endif
    \endif

    --------------------------------------------------------------------------------------------------------------------
    -- выводим информационные сообщения

    \echo :head'\n# SERVER':reset

    \if :{?systemd_unit}
        \echo 'Systemd unit:          ':systemd_unit' (pid=':postgres_pid')'
    \endif

    \echo 'Started at:            ':started_at' (':start_uptime' ago)'
    \echo 'Config loaded at:      ':loaded_at' (':load_uptime' ago)'

    \if :{?bin_directory}
        \echo 'Bin directory:         ':bin_directory
    \endif

    \if :{?data_directory}
        \set str 'Data directory:        ':data_directory
        \if :{?data_directory_size}
            \set str :str' (size: ':data_directory_size' total)'
        \endif
        \echo :str
    \endif

    \if :{?wal_directory}
        \set str 'WAL directory:         ':wal_directory
        \if :{?wal_real_directory}
            \set str :str' → ':wal_real_directory
        \endif
        \if :{?wal_directory_size}
            \set str :str' (size: ':wal_directory_size' total)'
        \endif
        \echo :str
    \endif

    \if :{?log_directory}
        \set str 'Log directory:         ':log_directory
        \if :{?log_files_size}
            \set str :str' (size: ':log_files_size' files)'
        \endif
        \echo :str
    \endif

    \if :{?used_connections_percent}
        \if `test :used_connections_percent -gt 80 && echo 1 || echo 0`
            \set color :red
        \elif `test :used_connections_percent -gt 60 && echo 1 || echo 0`
            \set color :orange
        \else
            \set color :reset
        \endif
        \echo 'Connections:           ':used_connections' of ':max_connections' ':color'(used ':used_connections_percent'%)':reset
    \endif

    \if :{?used_shared_buffers}
        \echo 'Shared buffers/cache:  ':used_shared_buffers' of ':total_shared_buffers' (used ':used_shared_buffers_percent'%)'
    \elif :{?shared_buffers}
        \echo 'Shared buffers/cache:  ':shared_buffers
    \endif

    \if :is_primary
        \echo 'Server role:           ':primary_style'primary':reset' (read-write)'
    \else
       \if :wal_receive_count
           \echo 'Server role:           ':replica_active_style'replica':reset' (read only)'
           \echo 'WAL receive (1):       ':wal_receive_from
       \else
           \echo 'Server role:           ':replica_inactive_style'replica':reset' (read only)'
           \echo 'WAL receive (0):       ':warn'connection to primary is not established or lost':reset
       \endif
    \endif

    \echo 'WAL send (':wal_send_count'):          ':wal_send_to

    \echo 'Synchronous commit:    ':synchronous_commit
    \echo 'Sync. standby names:   ':synchronous_standby_names

    \if :{?shared_preload_libraries}
        \echo 'Shared preload libs:   ':shared_preload_libraries
    \endif

    \if :{?walsender_plugin_libraries}
        \echo 'Walsender plugin libs: ':walsender_plugin_libraries
    \endif

    \if :is_archive_active
        \echo 'Archive mode:          ':archive_mode' (timeout: ':archive_timeout')'
        \if :{?archive_command}
            \echo 'Archive command:       ':archive_command
        \endif
        \if :{?restore_command}
            \echo 'Restore command:       ':restore_command
        \endif
    \else
        \echo 'Archive mode:          ':archive_mode
    \endif

    --------------------------------------------------------------------------------------------------------------------
    \echo :head'\n# DATABASE':reset

    \echo 'Current database:      ':db_name' (size: ':db_size' total)'
    \echo 'Cache hit ratio:       ':db_cache_hit_ratio'%'

    \if :{?installed_extensions}
        \echo 'Installed extensions:  ':installed_extensions
    \endif

    --------------------------------------------------------------------------------------------------------------------
    \echo :head'\n# SHORT SQL':reset

    \echo ':W — who am i'
    \echo ':A — stat activity groups counts'
    \echo ':T — cluster topology (first, run `psql -v pro=install` and `nano ~/.pgpass` to save/check password exists for user postgres)'
    \echo

    --------------------------------------------------------------------------------------------------------------------
    \if :is_superuser

        -- проверяем наличие ошибок в конфигурационных файлах
        with fs as (
            select distinct on (name) *
            from pg_file_settings -- non commented rows of config files
            order by name, seqno desc
        )
        select
            current_setting('config_file') as config_file,
            current_setting('hba_file') as hba_file,
            exists(
                select
                from fs
                join pg_settings as s on lower(fs.name) = lower(s.name)
                where not fs.applied and not s.pending_restart
            ) as is_config_file_error,
            exists(select from pg_hba_file_rules where error is not null) as is_hba_file_error
        \gset

        \if :is_config_file_error
            \echo :error'Errors found in config file "':config_file'"':reset

            with fs as (
                select distinct on (name) *
                from pg_file_settings
                order by name, seqno desc
            )
            select fs.sourcefile, fs.sourceline, fs.name, fs.setting, fs.applied, fs.error,
                   s.vartype, s.min_val, s.max_val, s.enumvals, s.extra_desc
            from fs
            join pg_settings as s on lower(fs.name) = lower(s.name)
            where not fs.applied and not s.pending_restart
            order by fs.sourcefile, fs.sourceline
            \gx
        \endif

        \if :is_hba_file_error
            \echo :error'Errors found in hba file "':hba_file'"':reset

            select *
            from pg_hba_file_rules
            where error is not null
            order by line_number
            \gx
        \endif

    \endif

\endif

-- включаем отображение длительности выполнения запроса
\timing 1

-- восстанавливаем флаг отображения информационных сообщений
\set QUIET :QUIET_ORIGINAL
